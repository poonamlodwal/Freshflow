# ──────────────────────────────────────────────────────────────────────────────
# FreshChain ML Service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Model ─────────────────────────────────────────────────────────────────────
# Hugging Face model ID to use for produce quality classification.
# Options documented in architecture.md §6:
#   jazzmacedo/fruits-and-vegetables-detector-36   (ResNet-50, faster)
#   dima806/fruit_vegetable_image_detection         (ViT, higher accuracy)
HF_MODEL_ID=jazzmacedo/fruits-and-vegetables-detector-36

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite, zero config):
DATABASE_URL=sqlite+aiosqlite:///./freshchain.db

# Production (Postgres via Neon/Supabase — replace with your actual URL):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Next.js frontend.
# Local dev:
ALLOWED_ORIGINS=http://localhost:3000

# Production (add your Vercel deployment URL):
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Shelf-life thresholds (days) ──────────────────────────────────────────────
SHELF_LIFE_FRESH_DAYS=7
SHELF_LIFE_EXPIRING_DAYS=2
SHELF_LIFE_ROTTEN_DAYS=0

# Batches at or below this many days get isNearExpiry=true
NEAR_EXPIRY_THRESHOLD=3

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Timeout (seconds) when fetching images from Supabase/Cloudinary URLs
IMAGE_FETCH_TIMEOUT=10

# ── Hugging Face Hub ──────────────────────────────────────────────────────────
# Optional but recommended: avoids rate-limit warnings on first model download.
# Get a free token at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Suppresses a harmless symlink warning on Windows without Developer Mode enabled.
HF_HUB_DISABLE_SYMLINKS_WARNING=1
