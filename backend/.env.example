# FreshChain ML Service — .env example
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to git.

# ── ML Model ────────────────────────────────────────────────────────────────
# HuggingFace model repo ID used for produce classification.
# See memory.md §5 for model reference and attribution requirements.
HF_MODEL_ID=jazzmacedo/fruits-and-vegetables-detector-36

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
ENV=development          # set to "production" on Render / HF Spaces

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Add your Vercel preview URL during development.
# In production this should be ONLY the deployed Next.js URL.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Security ─────────────────────────────────────────────────────────────────
# Used to guard the /retrain endpoint. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SECRET=changeme-use-a-long-random-string-in-prod
